    width: 100%;
    height: 100%;
    display: block;
    background: #1a1a2e;
    color: #e6edf3;
    font-family: system-ui, sans-serif;
}

.header {
    padding: 20px;
    text-align: center;
}

.header h1 {
    margin: 0;
    font-size: 24px;
}

.content {
    display: flex;
    justify-content: center;
    padding: 20px;
}

.card {
    background: #16213e;
    padding: 24px;
    border-radius: 12px;
    text-align: center;
    min-width: 300px;
}

.count-display {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 20px;
}

.actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 16px;
}

.btn {
    padding: 10px 20px;
    font-size: 16px;
    background: #3478f6;
