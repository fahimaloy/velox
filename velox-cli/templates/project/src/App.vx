<template>
  <div class="app">
    <header class="header">
      <h1>{{ title }}</h1>
    </header>
    <main class="content">
      <div class="card">
        <p class="count-display">Count: {{ count }}</p>
        <div class="actions">
          <button class="btn" @click="increment">+1</button>
          <button class="btn" @click="decrement">-1</button>
          <button class="btn" @click="reset">Reset</button>
        </div>
        <p v-if="count > 0" class="status positive">Count is positive</p>
        <p v-else-if="count < 0" class="status negative">Count is negative</p>
        <p v-else class="status neutral">Count is zero</p>
      </div>
    </main>
  </div>
</template>

<script setup>
use std::rc::Rc;
use velox_core::signal::Signal;

pub struct State {
    pub count: Rc<Signal<i32>>,
    pub title: Rc<Signal<String>>,
}

impl State {
    pub fn new() -> Self {
        Self {
            count: Rc::new(Signal::new(0)),
            title: Rc::new(Signal::new(String::from("Hello Velox!"))),
        }
    }

    pub fn increment(&self) {
        self.count.set(self.count.get() + 1);
        self.title.set(format!("Count: {}", self.count.get()));
    }

    pub fn decrement(&self) {
        self.count.set(self.count.get() - 1);
        self.title.set(format!("Count: {}", self.count.get()));
    }

    pub fn reset(&self) {
        self.count.set(0);
        self.title.set(String::from("Hello Velox!"));
    }
}
</script>

<style scoped>
.app {
    width: 100%;
    height: 100%;
    display: block;
    background: #1a1a2e;
    color: #e6edf3;
    font-family: system-ui, sans-serif;
}

.header {
    padding: 20px;
    text-align: center;
}

.header h1 {
    margin: 0;
    font-size: 24px;
}

.content {
    display: flex;
    justify-content: center;
    padding: 20px;
}

.card {
    background: #16213e;
    padding: 24px;
    border-radius: 12px;
    text-align: center;
    min-width: 300px;
}

.count-display {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 20px;
}

.actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 16px;
}

.btn {
    padding: 10px 20px;
    font-size: 16px;
    background: #3478f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

.btn:hover {
    background: #4a8df8;
}

.status {
    font-size: 14px;
    margin-top: 12px;
}

.positive { color: #3fb950; }
.negative { color: #f85149; }
.neutral { color: #8b949e; }
</style>
