<template>
  <div class="app">
    <header class="header">
      <h1>{{ title }}</h1>
    </header>
    <main class="content">
      <div class="card">
        <p>Count: {{ count }}</p>
        <button class="btn" @click="increment">Increment</button>
      </div>
    </main>
  </div>
</template>

<script setup>
import { ref } from 'velox'

const title = 'Hello Velox!'
const count = ref(0)

const increment = () => {
  count.value++
}
</script>

