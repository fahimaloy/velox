  font-size: 3.5rem;
  font-weight: 700;
  color: #667eea;
  line-height: 1.2;
}

.label {
  font-size: 0.875rem;
  color: #666;
  margin-top: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
}

