<template>
  <div class="app">
    <header class="header">
      <h1>{{ title }}</h1>
      <p class="subtitle">Interactive Counter with Styling</p>
    </header>

    <main class="content">
      <div class="card">
        <div class="display">
          <div class="count">{{ count }}</div>
          <p class="label">Current Count</p>
        </div>

        <div class="controls">
          <button class="btn btn-primary" @click="increment">
            +1
          </button>
          <button class="btn btn-secondary" @click="decrement">
            -1
          </button>
          <button class="btn btn-danger" @click="reset">
            Reset
          </button>
        </div>

        <div class="input-group">
          <label>Add Custom Value:</label>
          <input
            type="text"
            class="input"
            @input="onValueInput"
            @change="onValueChange"
            placeholder="Enter number"
          />
          <button class="btn btn-success" @click="addCustomValue">
            Add
          </button>
        </div>

        <div class="status">
          <p v-if="count > 0" class="positive">Count is positive ✓</p>
          <p v-else-if="count < 0" class="negative">Count is negative ✗</p>
          <p v-else class="neutral">Count is zero</p>
        </div>
      </div>
    </main>
  </div>
</template>

<script setup>
use std::cell::Cell;
use std::rc::Rc;

pub struct State {
  pub count: Cell<i32>,
  pub title: Cell<String>,
  pub input_value: Cell<String>,
}

impl State {
  pub fn new() -> Self {
    Self {
      count: Cell::new(0),
      title: Cell::new("Velox Counter".to_string()),
      input_value: Cell::new(String::new()),
    }
  }

  pub fn increment(&self) {
    let v = self.count.get() + 1;
    self.count.set(v);
  }

  pub fn decrement(&self) {
    let v = self.count.get() - 1;
    self.count.set(v);
  }

  pub fn reset(&self) {
    self.count.set(0);
    self.input_value.set(String::new());
  }

  pub fn add_custom(&self) {
    if let Ok(val) = self.input_value.borrow().parse::<i32>() {
      let current = self.count.get();
      self.count.set(current + val);
      self.input_value.set(String::new());
    }
  }
}
</script>

<style>
