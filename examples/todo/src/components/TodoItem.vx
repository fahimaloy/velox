<template>
  <div class="todo-item"><p class="text" :class="{ done: completed }">{{ todo }}</p><button class="btn" @click="on_toggle" :click-payload="index">Toggle</button><button class="btn remove" @click="on_remove" :click-payload="index">Remove</button></div>
</template>

<script setup>
pub struct Props {
    pub todo: String,
    pub completed: bool,
    pub index: String,
}

pub struct State {
    pub props: Props,
}

impl State {
    pub fn new() -> Self {
        Self {
            props: Props {
                todo: String::new(),
                completed: false,
                index: String::from("0"),
            },
        }
    }

    pub fn todo(&self) -> String {
        self.props.todo.clone()
    }

    pub fn completed(&self) -> bool {
        self.props.completed
    }

    pub fn index(&self) -> String {
        self.props.index.clone()
    }

    // Toggle/remove payloads travel through the owning App state.
    pub fn on_toggle(&self) {}

    pub fn on_remove(&self) {}
}
</script>

<style scoped>
/*
 * A card per todo. `:class="{ done: completed }"` swaps in the `.done` class
 * when the item is completed, so the base typography lives on the descendant
 * selector below and `.done` only supplies the completed colour.
 */
.todo-item {
    display: block;
    margin: 0 0 8px 0;
    padding: 10px 12px;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #1e293b;
}
.todo-item p {
    display: block;
    margin: 0 0 6px 0;
    font-size: 15px;
}
.done {
    color: #22c55e;
}
.btn {
    display: block;
    height: 28px;
    margin: 0 0 4px 0;
    padding: 4px 8px;
    border: 1px solid #334155;
    border-radius: 6px;
    background: #0f172a;
    color: #cbd5e1;
    font-size: 12px;
    text-align: center;
    cursor: pointer;
}
.remove {
    color: #fca5a5;
}
</style>
