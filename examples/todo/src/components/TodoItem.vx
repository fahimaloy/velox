<template>
  <div class="todo-item" :class="{ completed: completed }">
    <input
      type="checkbox"
      class="checkbox"
      :checked="completed"
      @click="on_toggle"
      :click-payload="index"
    />
    <span class="todo-text">{{ text }}</span>
    <button class="btn btn-danger btn-small" @click="on_remove" :click-payload="index">×</button>
  </div>
</template>

<script setup>
pub struct Props {
    pub todo: String,
    pub completed: bool,
    pub index: String,
}

pub struct State {
    pub props: Props,
}

impl State {
    pub fn new() -> Self {
        Self {
            props: Props {
                todo: String::new(),
                completed: false,
                index: String::new(),
            }
        }
    }

    pub fn text(&self) -> String {
        self.props.todo.clone()
    }

    pub fn completed(&self) -> bool {
        self.props.completed
    }

    pub fn index(&self) -> String {
        self.props.index.clone()
    }

    // Events bubble to the owning (Todos) State via the root dispatcher; these
    // no-ops keep the generated per-component dispatcher compiling.
    pub fn on_toggle(&self) {}
    pub fn on_remove(&self) {}
}
</script>

<style scoped>
.todo-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: #16213e;
    border-radius: 10px;
}
.todo-item.completed .todo-text {
    text-decoration: line-through;
    color: #8b949e;
}
.checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #3478f6;
}
.todo-text {
    flex: 1;
    font-size: 15px;
}
.btn {
    padding: 6px 12px;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    color: #ffffff;
}
.btn-danger {
    background: #ef4444;
}
.btn-danger:hover {
    background: #dc2626;
}
.btn-small {
    padding: 4px 10px;
}
</style>
