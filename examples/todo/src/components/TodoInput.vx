<template>
  <div class="todo-input"><input type="text" class="input" :value="value" :placeholder="placeholder" @input="on_input" /><button class="btn-add" @click="on_submit">Add</button></div>
</template>

<script setup>
pub struct Props {
    pub value: String,
    pub placeholder: String,
}

pub struct State {
    pub props: Props,
}

impl State {
    pub fn new() -> Self {
        Self {
            props: Props {
                value: String::new(),
                placeholder: String::from("What needs to be done?"),
            },
        }
    }

    pub fn value(&self) -> String {
        self.props.value.clone()
    }

    pub fn placeholder(&self) -> String {
        self.props.placeholder.clone()
    }

    // Child events bubble to the owning App state through the root
    // dispatcher; these stubs keep the generated dispatcher compiling.
    pub fn on_input(&self) {}

    pub fn on_submit(&self) {}
}
</script>

<style scoped>
/*
 * Velox stacks the input and the button as blocks, which keeps both their
 * fills and their labels inside their own boxes.
 */
.todo-input {
    display: block;
}
.input {
    display: block;
    height: 34px;
    margin: 0 0 6px 0;
    padding: 6px 10px;
    border: 1px solid #334155;
    border-radius: 6px;
    background: #1e293b;
    color: #e2e8f0;
    font-size: 14px;
}
.btn-add {
    display: block;
    height: 34px;
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
    background: #38bdf8;
    color: #0f172a;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
}
</style>
