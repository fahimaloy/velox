    text-align: center;
    font-size: 28px;
    font-weight: bold;
    padding: 24px 0 12px;
    margin: 0;
}
.card {
    background: #27272a;
    border-radius: 12px;
    padding: 20px;
    margin: 0 24px;
}
.input-row {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}
.btn {
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: #ffffff;
}
.inc { background: #22c55e; }
.inc:hover { background: #16a34a; }
.dec { background: #ef4444; }
.dec:hover { background: #dc2626; }
.reset { background: #64748b; }
.reset:hover { background: #475569; }
.counter {
    display: flex;
    justify-content: center;
    padding: 20px;
}
.count {
    font-size: 48px;
    font-weight: bold;
}
.status {
    text-align: center;
    color: #71717a;
