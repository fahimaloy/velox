<template>
  <div class="app">
    <h1 class="title">Todo List</h1>
    <div class="card">
      <div class="input-row">
        <button class="btn inc" @click="increment">+1</button>
        <button class="btn dec" @click="decrement">-1</button>
        <button class="btn reset" @click="reset">Reset</button>
      </div>
      <div class="counter">
        <span class="count">{{ count }}</span>
      </div>
      <p class="status">Click a button to change the counter</p>
    </div>
  </div>
</template>

<script setup>
use std::cell::Cell;

pub struct State {
    count: Cell<i32>,
}

impl State {
    pub fn new() -> Self {
        Self { count: Cell::new(0) }
    }
    pub fn get_count(&self) -> i32 { self.count.get() }
    pub fn increment(&self) { self.count.set(self.count.get() + 1); }
    pub fn decrement(&self) { self.count.set(self.count.get() - 1); }
    pub fn reset(&self) { self.count.set(0); }
}
</script>

