<template>
  <div class="app"><h1 class="title">{{ title }}</h1><TodoInput :value="draft" :placeholder="input_placeholder" @input="on_input" @submit="on_submit" /><button class="filter" @click="cycle_filter">{{ filter_label }}</button><div class="list"><TodoItem v-for="(todo, idx) in visible" :todo="todo.text" :completed="todo.completed" :index="idx" @toggle="on_toggle" @remove="on_remove" /><p class="empty" v-if="empty_message">{{ empty_message }}</p></div></div>
</template>

<script setup>
import TodoInput from './components/TodoInput.vx'
import TodoItem from './components/TodoItem.vx'

use velox_core::signal::Signal;

#[derive(Clone, Copy, PartialEq)]
pub enum Filter {
    All,
    Active,
    Completed,
}

#[derive(Clone, PartialEq)]
pub struct Todo {
    pub id: usize,
    pub text: String,
    pub completed: bool,
}

pub struct State {
    // Every field is a reactive signal created with the `signal!()` macro,
    // which expands to `std::rc::Rc::new(Signal::new(value))`.
    pub todos: std::rc::Rc<Signal<Vec<Todo>>>,
    pub draft: std::rc::Rc<Signal<String>>,
    pub filter: std::rc::Rc<Signal<Filter>>,
    pub next_id: std::rc::Rc<Signal<usize>>,
    // A derived signal: it recomputes whenever `todos` or `filter` changes, so
    // the template can v-for over the currently visible subset.
    pub visible: std::rc::Rc<Signal<Vec<Todo>>>,
}

impl State {
    pub fn new() -> Self {
        let todos = velox_core::signal!(todos = vec![
        Todo {
            id: 0,
            text: String::from("Build a todo app"),
            completed: false,
        },
        Todo {
            id: 1,
            text: String::from("Learn Velox"),
            completed: true,
        },
    ]);
        let draft = velox_core::signal!(draft = String::new());
        let filter = velox_core::signal!(filter = Filter::All);
        let next_id = velox_core::signal!(next_id = 2usize);

        let visible = {
            let todos = std::rc::Rc::clone(&todos);
            let filter = std::rc::Rc::clone(&filter);
            velox_core::signal::computed(move || {
                let list = todos.get();
                match filter.get() {
                    Filter::All => list,
                    Filter::Active => {
                        list.into_iter().filter(|todo| !todo.completed).collect()
                    }
                    Filter::Completed => {
                        list.into_iter().filter(|todo| todo.completed).collect()
                    }
                }
            })
        };

        Self {
            todos,
            draft,
            filter,
            next_id,
            visible,
        }
    }

    pub fn title(&self) -> String {
        String::from("Velox Todo")
    }

    pub fn input_placeholder(&self) -> String {
        String::from("What needs to be done?")
    }

    pub fn draft(&self) -> String {
        self.draft.get()
    }

    pub fn filter_label(&self) -> String {
        match self.filter.get() {
            Filter::All => String::from("Filter: all todos"),
            Filter::Active => String::from("Filter: active todos"),
            Filter::Completed => String::from("Filter: completed todos"),
        }
    }

    // An empty string hides the empty state, and doubles as its v-if
    // condition because interpolation keys are the ones make_resolve knows.
    pub fn empty_message(&self) -> String {
        if !self.visible.get().is_empty() {
            return String::new();
        }
        match self.filter.get() {
            Filter::All => String::from("Nothing to do yet. Add a todo above."),
            Filter::Active => String::from("No active todos. Nice work!"),
            Filter::Completed => String::from("No completed todos yet."),
        }
    }

    pub fn on_input(&self, payload: &str) {
        self.draft.set(payload.to_string());
    }

    pub fn on_submit(&self) {
        let text = self.draft.get().trim().to_string();
        if text.is_empty() {
            return;
        }
        let id = self.next_id.get();
        self.next_id.set(id + 1);
        self.todos.update(|mut todos| {
            todos.push(Todo {
                id,
                text,
                completed: false,
            });
            todos
        });
        self.draft.set(String::new());
    }

    // TodoItem reports its position within the *visible* (filtered) list, so
    // resolve that index back to the item's id before mutating the source list.
    pub fn on_toggle(&self, payload: &str) {
        if let Ok(vidx) = payload.trim().parse::<usize>() {
            let visible = self.visible.get();
            if let Some(target) = visible.get(vidx) {
                let id = target.id;
                self.todos.update(|mut todos| {
                    if let Some(todo) = todos.iter_mut().find(|todo| todo.id == id) {
                        todo.completed = !todo.completed;
                    }
                    todos
                });
            }
        }
    }

    pub fn on_remove(&self, payload: &str) {
        if let Ok(vidx) = payload.trim().parse::<usize>() {
            let visible = self.visible.get();
            if let Some(target) = visible.get(vidx) {
                let id = target.id;
                self.todos.update(|mut todos| {
                    todos.retain(|todo| todo.id != id);
                    todos
                });
            }
        }
    }

    // One button cycles through the three filters, so the same control always
    // shows the current selection in its label.
    pub fn cycle_filter(&self) {
        let next = match self.filter.get() {
            Filter::All => Filter::Active,
            Filter::Active => Filter::Completed,
            Filter::Completed => Filter::All,
        };
        self.filter.set(next);
    }
}
</script>

<style scoped>
.app {
    width: 100%;
    min-height: 100vh;
    display: block;
    padding: 6px 14px 20px;
    background: #0f172a;
    color: #e2e8f0;
    font-family: system-ui, -apple-system, sans-serif;
}
.title {
    display: block;
    margin: 0 0 4px 0;
    font-size: 20px;
    font-weight: 700;
}
/*
 * Velox lays buttons out as blocks, so the filter chip spans the content
 * width and centers its label with `text-align`.
 */
.filter {
    display: block;
    height: 36px;
    margin: 0 0 8px 0;
    padding: 6px 12px;
    border: 1px solid #475569;
    border-radius: 999px;
    background: #334155;
    color: #e2e8f0;
    font-size: 13px;
    text-align: center;
    cursor: pointer;
}
/*
 * The list is a fixed-height block with `overflow: auto`, so a long todo list
 * scrolls inside the window instead of stretching the page.
 */
.list {
    display: block;
    height: 46vh;
    overflow: auto;
    padding: 2px;
}
.empty {
    display: block;
    margin: 16px 0 0 0;
    text-align: center;
    font-size: 14px;
    color: #94a3b8;
}
</style>
